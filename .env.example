# PhishGuard Environment Configuration

# IMAP Configuration (One.com, etc.)
IMAP_HOST=imap.one.com
IMAP_PORT=993
IMAP_USERNAME=your-email@domain.com
IMAP_PASSWORD=your-app-password
IMAP_USE_SSL=true

# Microsoft Graph Configuration (Outlook / Microsoft 365)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
MICROSOFT_GRAPH_ENDPOINT=https://graph.microsoft.com/v1.0

# API Configuration
API_HOST=localhost
API_PORT=8000
API_DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Testing
TEST_MODE=false
TEST_EMAIL_DIR=test_emails/
